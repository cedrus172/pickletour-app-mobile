# Set by expo-router. This enables Fabric-only features from react-native-screens
ENV['RNS_GAMMA_ENABLED'] ||= '1'
require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

ENV['RCT_NEW_ARCH_ENABLED'] ||= '0' if podfile_properties['newArchEnabled'] == 'false'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'

# use_frameworks! static + React Native Firebase: build RNFirebase dạng static
# framework để module map đúng (khử lỗi "RCTBridgeModule must be imported..." ở
# RNFBCrashlytics/RNFBApp).
$RNFirebaseAsStaticFramework = true

prepare_react_native_project!

target 'Pickletourvn' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'npx',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

# @generated begin pre_installer - expo prebuild (DO NOT MODIFY) sync-c8812095000d6054b846ce74840f0ffb540c2757
  pre_install do |installer|
# @generated begin @rnmapbox/maps-pre_installer - expo prebuild (DO NOT MODIFY) sync-ea4905840bf9fcea0acc62e92aa2e784f9d760f8
    $RNMapboxMaps.pre_install(installer)
# @generated end @rnmapbox/maps-pre_installer
  end
# @generated end pre_installer
  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
# @generated begin @rnmapbox/maps-post_installer - expo prebuild (DO NOT MODIFY) sync-c4e8f90e96f6b6c6ea9241dd7b52ab5f57f7bf36
    $RNMapboxMaps.post_install(installer)
# @generated end @rnmapbox/maps-post_installer
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => podfile_properties['apple.ccacheEnabled'] == 'true',
    )
    # Fix use_frameworks! static + React Native Firebase (RNFBApp): cho phép include
    # header non-modular bên trong framework module (nếu không sẽ lỗi build RNFB*).
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        # SDK iOS 27.1 yêu cầu deployment target >= 15.0. Đồng thời app target = 16.1 và
        # expo-router (LinkPreviewNativeActionView.swift) dùng API chỉ có từ iOS 16.0.
        # → Ép MỌI pod lên 16.1 (khớp app) để vừa thoả SDK 27.1 vừa hết lỗi
        # "'subtitle' is only available in iOS 16.0 or newer".
        cur = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if cur.nil? || cur.to_f < 16.1
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.1'
        end
        # Xcode 27.1 / RN new-arch: hermes-engine ship `hermesvm.xcframework` và KHÔNG
        # copy public headers sang Pods/Headers/Public/hermes-engine, nên các pod dùng
        # `#import <hermes/hermes.h>` (expo-modules-core EXJavaScriptRuntime.mm) báo
        # "'hermes/hermes.h' file not found". Ép destroot/include vào header search path.
        hsp = config.build_settings['HEADER_SEARCH_PATHS'] || '$(inherited)'
        hsp = hsp.join(' ') if hsp.is_a?(Array)
        unless hsp.include?('hermes-engine/destroot/include')
          config.build_settings['HEADER_SEARCH_PATHS'] = "#{hsp} \"${PODS_ROOT}/hermes-engine/destroot/include\""
        end
        # Hai pod này dùng trực tiếp các header C++ của React Native khi archive với static frameworks.
        if %w[RNGestureHandler RNSVG].include?(target.name)
          config.build_settings['HEADER_SEARCH_PATHS'] = %("${PODS_ROOT}/../../node_modules/react-native/ReactCommon" #{config.build_settings['HEADER_SEARCH_PATHS']})
        end
        # RN Firebase (ObjC) + use_frameworks: tắt clang modules cho RNFB* để
        # `#import <React/...>` là textual include (khử lỗi "RCTBridgeModule must be
        # imported from module RNFBApp.RNFBAppModule before it is required").
        if target.name.start_with?('RNFB')
          config.build_settings['CLANG_ENABLE_MODULES'] = 'NO'
        end
      end
    end
    # fmt 11 + clang Xcode 27.1: format-string consteval vỡ ("call to consteval
    # function ... is not a constant expression"). base.h define FMT_USE_CONSTEVAL
    # vô điều kiện (không có #ifndef) nên -D không override được → vá thẳng header,
    # ép về 0 (fmt tự fallback constexpr/runtime check, không đổi hành vi).
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      txt = File.read(fmt_base)
      if txt.include?('#  define FMT_USE_CONSTEVAL 1')
        File.chmod(0644, fmt_base) rescue nil
        txt = txt.gsub('#  define FMT_USE_CONSTEVAL 1',
                       '#  define FMT_USE_CONSTEVAL 0 /* forced: clang Xcode 27.1 */')
        File.write(fmt_base, txt)
        Pod::UI.puts '[PickleTour] Patched fmt base.h: FMT_USE_CONSTEVAL -> 0'
      end
    end
  end
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true
  pod 'HaishinKit', '~> 1.6.2'   # hoặc version 1.x mới nhất trên CocoaPods
  pod 'Logboard', '~> 2.4.1'
  # THÊM FIREBASE PODS
  pod 'Firebase/Analytics'
  pod 'Firebase/Core'
end
